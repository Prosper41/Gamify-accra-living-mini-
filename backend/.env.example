
# Django
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=True

# PostgreSQL
DB_NAME=accra_life_mini
DB_USER=postgres
DB_PASSWORD=your_local_database_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend
FRONTEND_URL=http://localhost:3000

# Optional Brevo SMTP configuration
# Leave these unset to print password-reset emails in the terminal.
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_LOGIN=your_brevo_login
# BREVO_SMTP_KEY=your_brevo_smtp_key
# DEFAULT_FROM_EMAIL=Accra Life Mini <verified@example.com>
